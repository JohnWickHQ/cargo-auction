{
  "name": "cargo-auction",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-msw": "npx msw init public/",
    "test": "vitest run",
    "watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "knip": "knip",
    "knip:exports": "knip --exports",
    "knip:dependencies": "knip --dependencies",
    "finish": "npm run lint && npm run typecheck && npm run typecheck:e2e && npm test && npm run format:check && npm run knip && npm run build",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@mantine/core": "^7.17.0",
    "@mantine/dates": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "@tabler/icons-react": "^3.31.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.114.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "msw": "^2.7.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
